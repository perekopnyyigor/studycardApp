<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Studycard"
        tools:targetApi="31">

        <!-- Главная активность с LAUNCHER -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="studycard"
                    android:host="open"
                    android:pathPrefix="/main" />
            </intent-filter>
        </activity>

        <!-- Остальные активности -->
        <activity
            android:name=".PayFormActivity"
            android:exported="false"
            android:label="@string/title_activity_pay_form"
            android:theme="@style/Theme.Studycard" />
        <activity
            android:name=".CommercialActivity"
            android:exported="false" />
        <activity
            android:name=".ProgressActivity"
            android:exported="false" />
        <activity
            android:name=".InterstitialAdActivity"
            android:exported="false" />
        <activity
            android:name=".RegistrActivity"
            android:exported="false" />
        <activity
            android:name=".EndTestActivity"
            android:exported="false" />
        <activity
            android:name=".CalendarActivity"
            android:exported="false" />
        <activity
            android:name=".Enter_Activity"
            android:exported="false" />
        <activity
            android:name=".Test"
            android:exported="false" />
        <activity
            android:name=".TopicActivity"
            android:exported="false" />
        <activity
            android:name=".CoursActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="studycard"
                    android:host="open"
                    android:pathPrefix="/cours" />
            </intent-filter>
        </activity>

    </application>
</manifest>